{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["file://{{REPO_ROOT}}/packages/opencode/dist/index.js"],
  "provider": {
    "mockllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MockLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:{{MOCKLLM_PORT}}/v1",
        "apiKey": "none"
      },
      "models": {
        "mock-model": { "name": "Mock Model" }
      }
    }
  }
}
