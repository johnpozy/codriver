{
  "name": "@johnpozy/codriver-opencode",
  "version": "0.1.1",
  "repository": "https://github.com/johnpozy/codriver",
  "description": "opencode adapter for Codriver: a per-turn model-routing plugin — pick Auto, Jev picks the model.",
  "keywords": [
    "opencode",
    "model-routing",
    "jev",
    "auto"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@johnpozy/codriver": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@johnpozy/codriver": "*"
  }
}
