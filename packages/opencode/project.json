{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opencode",
  "projectType": "library",
  "sourceRoot": "packages/opencode/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/opencode",
        "command": "tsc -p tsconfig.build.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/opencode",
        "command": "tsgo --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/opencode",
        "command": "oxlint src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/opencode",
        "command": "bun test"
      }
    }
  }
}
