{
  "name": "timeout: a Jev timeout fails over to the configured fallback",
  "stateInput": {
    "agent": "build",
    "mode": "plan",
    "text": "Sketch the rollout plan for the new rate limiter.",
    "case": "timeout-fallback"
  },
  "config": {
    "fleet": [
      { "id": "anthropic/claude-opus", "description": "deep reasoning", "tags": ["reasoning"] },
      { "id": "openai/gpt-5.5", "description": "fast coding" },
      { "id": "google/gemini-3-pro", "description": "long context" }
    ],
    "fallback": "google/gemini-3-pro",
    "route_threshold": 0.55
  },
  "catalog": ["anthropic/claude-opus", "openai/gpt-5.5", "google/gemini-3-pro"],
  "scenario": {
    "error": { "kind": "timeout", "message": "Jev request timed out after 1500ms" }
  },
  "expected": { "model": { "providerID": "google", "modelID": "gemini-3-pro" }, "usedFallback": true, "reason": "timeout" }
}
